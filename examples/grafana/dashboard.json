{
 "uid": "cci-runner-fleet",
 "title": "CircleCI runner fleet",
 "tags": [
  "circleci",
  "runner"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "EC2 instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "grafanacloud-prom"
    },
    "query": {
     "query": "label_values(node_load1, instance_id)",
     "refId": "v"
    },
    "definition": "label_values(node_load1, instance_id)",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "job_id",
    "label": "Job ID",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Job starts",
    "datasource": {
     "type": "loki",
     "uid": "grafanacloud-logs"
    },
    "enable": true,
    "iconColor": "green",
    "expr": "{service_name=\"circleci-job-wrapper\"} | event=\"job_start\" | json | instance_id=~\"$instance\", instance_id!=\"\"",
    "titleFormat": "job start",
    "textFormat": "{{job_name}} on {{runner}}",
    "tagKeys": "runner,instance_id"
   },
   {
    "name": "Job ends",
    "datasource": {
     "type": "loki",
     "uid": "grafanacloud-logs"
    },
    "enable": false,
    "iconColor": "red",
    "expr": "{service_name=\"circleci-job-wrapper\"} | event=\"job_end\" | json | instance_id=~\"$instance\", instance_id!=\"\"",
    "titleFormat": "job end",
    "textFormat": "{{job_name}} on {{runner}}",
    "tagKeys": "runner,instance_id"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Fleet right now (wrapper busy gauge)",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Busy runners",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "sum(circleci_runner_busy{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Idle runners",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "count(circleci_runner_busy{instance_id=~\"$instance\", instance_id!=\"\"} == 0) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Runner hosts reporting",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "count(count by (instance_id) (node_load1{instance_id=~\"$instance\", instance_id!=\"\"}))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Busy runners over time",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "sum by (runner) (circleci_runner_busy{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "{{runner}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "fillOpacity": 30,
      "stacking": {
       "mode": "normal"
      }
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": []
   },
   "id": 6,
   "gridPos": {
    "h": 4,
    "w": 12,
    "x": 12,
    "y": 1
   }
  },
  {
   "type": "table",
   "title": "What each runner is doing now",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "description": "From the wrapper's per-runner Prometheus textfile. One row per runner agent; idle runners show no job.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "max by (runner, instance_id, resource_class, job_name, project, job_id) (circleci_runner_busy{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "time() - max by (runner, instance_id, resource_class, job_name, project, job_id) (circleci_runner_job_start_time_seconds{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "busy",
       "Value #B": "running for"
      },
      "indexByName": {
       "runner": 0,
       "instance_id": 1,
       "busy": 2,
       "job_name": 3,
       "running for": 4,
       "project": 5,
       "resource_class": 6,
       "job_id": 7
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "running for"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "busy"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "idle",
            "color": "blue"
           },
           "1": {
            "text": "busy",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "job_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Drill into this job",
          "url": "/d/cci-runner-fleet/circleci-runner-fleet?var-job_id=${__value.raw}&from=now-1h&to=now"
         }
        ]
       }
      ]
     }
    ]
   },
   "id": 7,
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 5
   }
  },
  {
   "type": "row",
   "title": "Host health (Alloy unix exporter), job starts as annotations",
   "id": 8,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU busy %",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "100 * (1 - avg by (instance_id) (rate(node_cpu_seconds_total{mode=\"idle\",instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval])))",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 9,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 13
   }
  },
  {
   "type": "timeseries",
   "title": "CPU IO wait %",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "100 * avg by (instance_id) (rate(node_cpu_seconds_total{mode=\"iowait\",instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval]))",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 10,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 13
   }
  },
  {
   "type": "timeseries",
   "title": "Memory used %",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance_id=~\"$instance\", instance_id!=\"\"} / node_memory_MemTotal_bytes{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 11,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 13
   }
  },
  {
   "type": "timeseries",
   "title": "Disk throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "sum by (instance_id) (rate(node_disk_read_bytes_total{instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval]) + rate(node_disk_written_bytes_total{instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval]))",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 12,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 20
   }
  },
  {
   "type": "timeseries",
   "title": "Network throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "sum by (instance_id) (rate(node_network_receive_bytes_total{device!=\"lo\",instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{device!=\"lo\",instance_id=~\"$instance\", instance_id!=\"\"}[$__rate_interval]))",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 13,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 20
   }
  },
  {
   "type": "timeseries",
   "title": "Load average (1m)",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "max by (instance_id) (node_load1{instance_id=~\"$instance\", instance_id!=\"\"})",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "id": 14,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 20
   }
  },
  {
   "type": "row",
   "title": "Jobs per host: wrapper + task agent logs (host side) and CircleCI spans",
   "id": 15,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 27
   },
   "panels": []
  },
  {
   "type": "bargauge",
   "title": "Jobs started per host (time range)",
   "datasource": {
    "type": "loki",
    "uid": "grafanacloud-logs"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "expr": "sum by (instance_id) (count_over_time({service_name=\"circleci-job-wrapper\"} | event=\"job_start\" | json | instance_id=~\"$instance\", instance_id!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant",
     "legendFormat": "{{instance_id}}"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "namePlacement": "left"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "min": 0
    },
    "overrides": []
   },
   "id": 16,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 28
   }
  },
  {
   "type": "table",
   "title": "Job results from CircleCI spans",
   "datasource": {
    "type": "tempo",
    "uid": "grafanacloud-traces"
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "grafanacloud-traces"
     },
     "queryType": "traceql",
     "query": "{ name =~ \"Job:.*\" } | select(span.com.circleci.job.id, span.com.circleci.job.name, span.com.circleci.job.status, span.com.circleci.resource.class)",
     "refId": "A",
     "limit": 100,
     "spss": 50,
     "tableType": "spans",
     "streaming": false
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "traceIdHidden": true,
       "traceService": true,
       "traceName": true,
       "spanID": true
      },
      "renameByName": {
       "com.circleci.job.id": "job_id",
       "com.circleci.job.name": "job_name",
       "com.circleci.job.status": "job result",
       "com.circleci.resource.class": "resource_class",
       "com.circleci.workflow.name": "workflow",
       "com.circleci.task.result": "step result",
       "name": "span"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "job result"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "success": {
            "color": "green"
           },
           "failed": {
            "color": "red"
           },
           "canceled": {
            "color": "orange"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "id": 17,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 28
   }
  },
  {
   "type": "table",
   "title": "Job results per host (task agent log on the host)",
   "datasource": {
    "type": "loki",
    "uid": "grafanacloud-logs"
   },
   "description": "From the task agent's own 'Reporting task end.' log line, collected by Alloy from the runner journal and tagged with the instance id. Many failures on one host at the same time points at a wedged worker.",
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "expr": "sum by (instance_id, result) (count_over_time({service_name=\"circleci-job-wrapper\"} | log_type=\"task_agent\" | event=\"task_end\" | json | result!=\"\" | instance_id=~\"$instance\", instance_id!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "jobs"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "cellOptions": {
       "type": "color-text"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "success": {
            "color": "green"
           },
           "failed": {
            "color": "red"
           },
           "canceled": {
            "color": "orange"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "sortBy": [
     {
      "displayName": "jobs",
      "desc": true
     }
    ]
   },
   "id": 18,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 28
   }
  },
  {
   "type": "timeseries",
   "title": "Failed jobs per host over time (spike = wedged worker)",
   "datasource": {
    "type": "loki",
    "uid": "grafanacloud-logs"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "expr": "sum by (instance_id) (count_over_time({service_name=\"circleci-job-wrapper\"} | log_type=\"task_agent\" | event=\"task_end\" | json | result=\"failed\" | instance_id=~\"$instance\", instance_id!=\"\" [5m]))",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "{{instance_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "min": 0,
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "id": 19,
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 36
   }
  },
  {
   "type": "table",
   "title": "Live step activity (task agent log, seconds behind real time)",
   "datasource": {
    "type": "loki",
    "uid": "grafanacloud-logs"
   },
   "description": "Step start/end lines from the task agent as they happen, unlike CircleCI spans which arrive when the job finishes.",
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "expr": "{service_name=\"circleci-job-wrapper\"} | log_type=\"task_agent\" | event=~\"step_start|step_end|task_start|task_end\" | instance_id=~\"$instance\", instance_id!=\"\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "transformations": [
    {
     "id": "extractFields",
