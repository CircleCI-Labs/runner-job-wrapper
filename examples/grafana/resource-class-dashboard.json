  {
   "type": "timeseries",
   "title": "Runner memory per runner",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "sum by (runner) (container_memory_working_set_bytes{cgroup=~\"/system.slice/circleci-runner.*\"} * on (cgroup) group_left (runner) max by (cgroup, runner) (circleci_runner_busy{resource_class=\"$rc\"}))",
     "legendFormat": "{{runner}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "fillOpacity": 20
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*failed.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*success.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*cancel.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
