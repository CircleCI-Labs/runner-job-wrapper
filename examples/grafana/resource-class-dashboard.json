       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "id": 12,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 12
   }
  },
  {
   "type": "timeseries",
