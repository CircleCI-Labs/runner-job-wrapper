     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*failed.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
