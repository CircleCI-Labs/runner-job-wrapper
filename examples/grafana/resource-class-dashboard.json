     "query": "{ name =~ \"Job:.*\" && span.com.circleci.resource.class = \"$rc\" } | select(span.com.circleci.job.name, span.com.circleci.job.status)"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "groupBy",
     "options": {
      "fields": {
       "com.circleci.job.name": {
        "aggregations": [],
        "operation": "groupby"
       },
       "duration": {
        "aggregations": [
         "count",
         "p50",
         "p95",
         "max"
        ],
        "operation": "aggregate"
       }
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "com.circleci.job.name": "job",
       "duration (count)": "runs",
       "duration (p50)": "median",
       "duration (p95)": "p95",
       "duration (max)": "max"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "median",
        "desc": true
       }
      ]
     }
    }
