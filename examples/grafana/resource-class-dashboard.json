      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*success.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
