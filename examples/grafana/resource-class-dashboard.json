  {
   "type": "timeseries",
   "title": "Host CPU busy % (hosts in this class)",
   "datasource": {
    "type": "prometheus",
    "uid": "grafanacloud-prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grafanacloud-prom"
     },
     "expr": "100 * (1 - avg by (instance_id) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))) and on (instance_id) max by (instance_id) (circleci_runner_busy{resource_class=\"$rc\"})",
     "legendFormat": "{{instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
