// Grafana Alloy: ship circleci-job-wrapper events + host metrics over OTLP.
// Works with Grafana Cloud's OTLP gateway or any OTLP/HTTP endpoint.
// Env (e.g. /etc/default/alloy): OTLP_ENDPOINT, OTLP_USERNAME, OTLP_PASSWORD,
// EC2_INSTANCE_ID (curl IMDSv2 /latest/meta-data/instance-id at install time)

// ---- 1. Job events written by circleci-job-wrapper (JSON lines) ----
local.file_match "cci_jobs" {
  path_targets = [{"__path__" = "/var/log/circleci-job-wrapper/jobs.jsonl", "source" = "circleci-job-wrapper"}]
}

loki.source.file "cci_jobs" {
  targets    = local.file_match.cci_jobs.targets
  forward_to = [loki.process.cci_jobs.receiver]
}

loki.process "cci_jobs" {
  // Promote a few low-cardinality fields to labels; job/workflow IDs stay in
  // the JSON body and are queried with `| json`.
  stage.json {
    expressions = { event = "event", resource_class = "resource_class", runner = "runner_name", instance_id = "instance_id" }
  }
  stage.labels {
    values = { event = "", resource_class = "", runner = "", instance_id = "" }
  }
  stage.static_labels {
    values = { service_name = "circleci-job-wrapper", log_type = "wrapper" }
  }
  forward_to = [otelcol.receiver.loki.default.receiver]
}

// ---- 1b. Optional: the task agent's own JSON log lines from the runner's
// journal (step start/end, task result). Gives live step progress and the job
// result on the host side. NOTE: internal task-agent log format; it may change
// between runner versions. Only lines with these messages are kept.
loki.relabel "runner_journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "runner" {
  matches       = "_SYSTEMD_UNIT=circleci-runner.service _SYSTEMD_UNIT=circleci-runner-b.service"
  relabel_rules = loki.relabel.runner_journal.rules
  forward_to    = [loki.process.task_agent.receiver]
}

loki.process "task_agent" {
  stage.match {
    selector = "{unit=~\".+\"} !~ \"\\\"msg\\\":\\\"(Runner started execution|step start|step end|Reporting task end\\\\.)\\\"\""
    action   = "drop"
  }
  stage.json {
    expressions = { msg = "msg", job_id = "\"job-id\"" }
  }
  stage.template {
    source   = "agent_event"
    template = "{{ if eq .msg \"Reporting task end.\" }}task_end{{ else if eq .msg \"Runner started execution\" }}task_start{{ else if eq .msg \"step start\" }}step_start{{ else }}step_end{{ end }}"
  }
  stage.labels {
    values = { event = "agent_event" }
  }
  stage.static_labels {
    values = { service_name = "circleci-job-wrapper", log_type = "task_agent" }
  }
  stage.static_labels {
    values = { instance_id = sys.env("EC2_INSTANCE_ID") }
  }
  forward_to = [otelcol.receiver.loki.default.receiver]
}

otelcol.receiver.loki "default" {
  output { logs = [otelcol.processor.transform.logs.input] }
}

// Name the log stream; event, job_id, runner etc. arrive as attributes
// (structured metadata in Loki).
otelcol.processor.transform "logs" {
  error_mode = "ignore"
  log_statements {
    context    = "resource"
    statements = ["set(attributes[\"service.name\"], \"circleci-job-wrapper\")"]
  }
  output { logs = [otelcol.processor.resourcedetection.default.input] }
}

// ---- 2. Host metrics (CPU, memory, disk, network, IO) ----
prometheus.exporter.unix "host" {
  // Optional: per-job "busy" gauges written by the wrapper (CCI_JOBLOG_PROM_DIR)
  textfile { directory = "/run/circleci-job-wrapper/prom" }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.receiver.prometheus "default" {
  output { metrics = [otelcol.processor.resourcedetection.default.input] }
}

// ---- 2b. Per-runner-agent CPU and memory (cAdvisor on the systemd cgroups).
// Each runner agent runs one job at a time in its own service cgroup, so this
// is per-job resource use over time. Join on the wrapper's `cgroup` field.
prometheus.exporter.cadvisor "runners" {
  docker_only    = false
  enabled_metrics = ["cpu", "memory", "diskIO"]
  storage_duration = "2m"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.runners.targets
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.runner_cgroups.receiver]
}

// Keep only the runner services' cgroups and the few series we chart.
prometheus.relabel "runner_cgroups" {
  rule {
    source_labels = ["id"]
    regex         = "/system.slice/circleci-runner.*\\.service"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_memory_rss|container_fs_(reads|writes)_bytes_total|container_blkio_device_usage_total"
    action        = "keep"
  }
  rule {
    source_labels = ["id"]
    target_label  = "cgroup"
  }
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

// ---- 3. Tag everything with the EC2 identity (host.id = instance id) ----
otelcol.processor.resourcedetection "default" {
  detectors = ["ec2", "system"]
  system { hostname_sources = ["os"] }
  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    logs    = [otelcol.exporter.otlphttp.default.input]
    metrics = [otelcol.processor.transform.metrics.input]
  }
}

// Put the EC2 instance id on every host metric so it joins with job events.
otelcol.processor.transform "metrics" {
  error_mode = "ignore"
  metric_statements {
    context    = "datapoint"
    statements = ["set(attributes[\"instance_id\"], resource.attributes[\"host.id\"])"]
  }
  output { metrics = [otelcol.exporter.otlphttp.default.input] }
}

otelcol.auth.basic "default" {
  username = sys.env("OTLP_USERNAME")
  password = sys.env("OTLP_PASSWORD")
}

otelcol.exporter.otlphttp "default" {
  client {
    endpoint = sys.env("OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.default.handler
  }
}
